  "register_and_texture_rules": [
    {
      "rule_id": "KEY_TEX_001",
      "name": "Standard Ballad Support",
      "applicable_styles": ["SLOW_BALLAD_8BEAT", "POPS_STANDARD"],
      "context_section": "verse",
      "left_hand_role": "root_support_low",
      "right_hand_role": "comping_mid_range",
      "register_guideline": "Keep LH C1-C3, RH C3-C5. Leave high frequencies for vocals.",
      "density_level": "low",
      "effect_on_arrangement": "Stabilizes the harmony without overpowering.",
      "avoid": "Playing melody in the same octave as the vocalist."
    },
    {
      "rule_id": "KEY_TEX_002",
      "name": "Rock Octave Power",
      "applicable_styles": ["ROCK_8BEAT_STANDARD", "PUNK_FAST_2BEAT"],
      "context_section": "chorus",
      "left_hand_role": "octave_doubling_bass",
      "right_hand_role": "octave_chords_high",
      "register_guideline": "Wide spread. LH deeply low, RH punching through C5-C6.",
      "density_level": "high",
      "effect_on_arrangement": "Adds brightness and attack to the wall of sound.",
      "avoid": "Complex jazz voicings (clashes with distortion)."
    },
    {
