  "register_and_texture_rules": [
    {
      "rule_id": "STR_TEX_001",
      "name": "Standard Octave Unison Melody",
      "applicable_styles": ["BALLAD_LEGATO_SWELL", "SHUFFLE_SOUL_STRINGS"],
      "context_section": "chorus",
      "instrument_group_roles": {
        "violins_1": "Main Melody High (8va)",
        "violins_2": "Main Melody Low (unison)",
        "violas": "Harmony/Counter-line",
        "cellos": "Bass/Tenor support",
        "basses": "Doubling Electric Bass"
      },
      "register_guideline": "V1 soars above C5. V2 supports an octave below for thickness.",
      "density_level": "high",
      "effect_on_arrangement": "Creates a singing, powerful lead line that cuts through the mix.",
      "avoid": "Crossing voices (Viola going higher than V2) unless intentional."
    },
    {
      "rule_id": "STR_TEX_002",
      "name": "Wide Pad Support",
      "applicable_styles": ["POP_STRING_PAD", "CINEMATIC_EMOTIVE"],
