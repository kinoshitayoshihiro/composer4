      "instrument_group_roles": {
        "violins_1": "High Pedal/Pad",
        "violins_2": "Mid Pad",
        "violas": "Mid-Low Pad",
        "cellos": "Root notes (sustained)",
        "basses": "Tacet (Silent)"
      },
      "register_guideline": "Open voicing. Keep the middle (C4) relatively open for vocals.",
      "density_level": "medium",
      "effect_on_arrangement": "Glues the band together without drawing attention.",
      "avoid": "Close voicings in the low-mid register (mud)."
    },
    {
      "rule_id": "STR_TEX_003",
      "name": "Ostinato Engine",
