        "violins_1": "Accents/Stabs",
        "violins_2": "Rhythmic Pattern (High)",
        "violas": "Rhythmic Pattern (Low)",
        "cellos": "Rhythmic Pattern (Bass)",
        "basses": "Impact hits"
      },
      "register_guideline": "Tight interlocking rhythms in the middle range.",
      "density_level": "high",
      "effect_on_arrangement": "Propulsive forward motion.",
      "avoid": "Long legato lines over the ostinato."
