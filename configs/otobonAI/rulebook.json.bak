{
“id”: “HRM_001”,
“name”: “王道進行（IV–V–iii–vi / 4536進行）”,
“domain”: “harmony”,
“situation”: “メジャーキーのサビや大サビで「青春・切なさ・前向きさ」を同時に出したいとき。”,
“mechanics”: {
“melody”: {
“scale_usage”: “メジャースケール中心。各コードの3度・6度を強拍で使い、2度・4度を経過音として扱う。”,
“contour”: “サビ冒頭で一気にレンジを上げ、進行の後半（iii→vi）にかけて少し落として余韻を作る。”,
“rhythm”: “歌詞のキーフレーズをIVまたはVの上で表に置き、viでシンコペーション気味に畳みかける。”
},
“harmony”: {
“progression”: [“IV”, “V”, “iii”, “vi”],
“key_center_relation”: “Iメジャーキーにおける 4→5→3→6。機能としてはサブドミナント→ドミナント→トニック的→トニック的に流れる。”,
“tension_usage”: “IV, V で9th、iii, vi では7thと9thを控えめに。avoid音（メジャーコード上の♭9など）は避ける。”
},
“bass”: {
“pattern”: “基本はルート中心の8分〜4分音符。V→iii→viの部分で5度→ルート→ルートの流れを明確にして安定感を出す。”,
“motion”: “IV→V→iii→viでそれぞれ下行3度 or 4度進行になりやすい。下行感を素直に出すことで「切なさ」が増す。”
},
“rhythm”: {
“groove”: “標準的な8ビート。ドラムはバスドラムがコードチェンジの頭をしっかり踏むと安定感が増す。”,
“density”: “サビではハイハット16分刻み＋スネア裏拍強調で推進力を維持。”
}
},
“emotion_effect”: “安心感のある明るさと、どこか切ないノスタルジーが同居する。「青春ソング」「アニソン」「J-POP王道バラード」でよく使われる。”,
“emotion_tags”: [“bright”, “nostalgic”, “bittersweet”, “hopeful”],
“guide_tone_tags”: [“3rd”, “7th”, “chord_tone”],
